{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(img|fonts|js|css)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/kit/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    },
    {
      "source": "/(og.jpg|favicon.ico|favicon-32.png|apple-touch-icon.png|icon-192.png|icon-512.png|site.webmanifest|robots.txt|sitemap.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: blob: https://pbs.twimg.com https://abs.twimg.com https://cdn.syndication.twimg.com; style-src 'self' 'unsafe-inline' https://platform.twitter.com; script-src 'self' https://platform.twitter.com https://cdn.syndication.twimg.com; font-src 'self' data:; connect-src 'self' https://api.dexscreener.com https://cdn.syndication.twimg.com https://syndication.twitter.com; frame-src https://platform.twitter.com https://syndication.twitter.com https://twitter.com https://x.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'"
        }
      ]
    }
  ]
}
